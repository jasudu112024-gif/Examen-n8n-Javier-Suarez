    {
      "parameters": {
        "jsCode": "// Agrupa todas las IDs de tutorías atascadas en un solo mensaje\nconst items = $input.all();\n\nif (items.length === 0) {\n  // No hay tutorías retrasadas: no se pasa nada al nodo de Telegram\n  return [];\n}\n\nconst ids = items.map(item => item.json.id_tutoria).join(', ');\n\nreturn [{\n  json: {\n    total_atascadas: items.length,\n    ids_atascadas: ids,\n    mensaje_alerta: `🚨 ATENCIÓN: Las siguientes tutorías llevan más de 45 min sin confirmar: [${ids}]. Favor verificar con el tutor/estudiante.`\n  }\n}];"
      },
